# 页面标题
VITE_APP_TITLE = RuoYi-Vue-Plus多租户管理系统
VITE_APP_LOGO_TITLE = RuoYi-Vue-Plus

# 生产环境配置
VITE_APP_ENV = 'production'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITOR_ADMIN = '/admin/applications'

# SnailJob 控制台地址
VITE_APP_SNAILJOB_ADMIN = '/snail-job'

# 生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

VITE_APP_PORT = 80

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true
# 接口加密传输 RSA 公钥与后端解密私钥对应 如更换需前后端一同更换
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ=='
# 接口响应解密 RSA 私钥与后端加密公钥对应 如更换需前后端一同更换
VITE_APP_RSA_PRIVATE_KEY = ''

# 业务接口的本地终端 clientid，不是 Keycloak 的 OIDC Client ID。
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'

# websocket 开关 默认使用sse推送
VITE_APP_WEBSOCKET = false

# sse 开关
VITE_APP_SSE = true

# Keycloak 统一认证公开配置，仅在前端构建时生效
# 前端统一认证入口开关，不自动修改后端启用或本地登录策略。
VITE_APP_KEYCLOAK_ENABLED = true
# SPA 回调相对路径，与浏览器 origin 组成完整 redirect_uri，须与登记值一致。
VITE_APP_KEYCLOAK_FRONTEND_CALLBACK_PATH = '/sso/callback'
# 完整对外 Realm 发行者（含 /realms/<realm>），与后端 issuer-uri 一致，不是业务 API 地址。
VITE_APP_KEYCLOAK_ISSUER_URI = 'http://192.168.3.82:8082/realms/aip'
# 当前应用的 OIDC Client ID，与后端实际登记一致；不是 VITE_APP_CLIENT_ID，禁止在前端放 Client Secret。
VITE_APP_KEYCLOAK_CLIENT_ID = '000000'
